<?xml version="1.0" encoding="UTF-8"?>
<Dictionary xmlns="http://www.opengis.net/gml/3.2"
            xmlns:gml="http://www.opengis.net/gml/3.2"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            gml:id="FP_PlanArt"
            xsi:schemaLocation="http://www.opengis.net/gml/3.2 http://schemas.opengis.net/gml/3.2.1/gml.xsd">
   <description>Aufzählung verschiedener Arten von Flächennutzungsplänen</description>
   <identifier codeSpace="urn:xplan">FP_PlanArt</identifier>
   <name>FP_PlanArt</name>
   <dictionaryEntry>
      <Definition gml:id="FP_PlanArt_1000">
         <description>Flächennutzungsplan nach § 5 BauGB.</description>
         <identifier codeSpace="urn:xplan">FP_PlanArt:1000</identifier>
         <name>FPlan</name>
         <name codeSpace="lesbarerName">FPlan</name>
      </Definition>
   </dictionaryEntry>
   <dictionaryEntry>
      <Definition gml:id="FP_PlanArt_2000">
         <description>Gemeinsamer Flächennutzungsplan nach § 204 BauGB</description>
         <identifier codeSpace="urn:xplan">FP_PlanArt:2000</identifier>
         <name>GemeinsamerFPlan</name>
         <name codeSpace="lesbarerName">Gemeinsamer FPlan</name>
      </Definition>
   </dictionaryEntry>
   <dictionaryEntry>
      <Definition gml:id="FP_PlanArt_3000">
