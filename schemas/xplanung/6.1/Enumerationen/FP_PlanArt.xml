         <name codeSpace="lesbarerName">Sachlicher Teilplan</name>
      </Definition>
   </dictionaryEntry>
   <dictionaryEntry>
      <Definition gml:id="FP_PlanArt_9999">
         <description>Sonstiger Flächennutzungsplan</description>
         <identifier codeSpace="urn:xplan">FP_PlanArt:9999</identifier>
         <name>Sonstiges</name>
         <name codeSpace="lesbarerName">Sonstiges</name>
      </Definition>
   </dictionaryEntry>
