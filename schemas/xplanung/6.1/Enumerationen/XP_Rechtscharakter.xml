   <dictionaryEntry>
      <Definition gml:id="XP_Rechtscharakter_7000">
         <description>Kennzeichnung von Fälchen nach §9 Absatz 5 BauGB. Kennzeichnungen sind keine rechtsverbindlichen Festsetzungen, sondern Hinweise auf Besonderheiten (insbesondere der Baugrundverhältnisse), deren Kenntnis für das Verständnis des Bebauungsplans und seiner Festsetzungen, wie auch für die Vorbereitung und Genehmigung von Vorhaben notwendig sind.</description>
         <identifier codeSpace="urn:xplan">XP_Rechtscharakter:7000</identifier>
         <name>Kennzeichnung</name>
         <name codeSpace="lesbarerName">Kennzeichnung</name>
      </Definition>
