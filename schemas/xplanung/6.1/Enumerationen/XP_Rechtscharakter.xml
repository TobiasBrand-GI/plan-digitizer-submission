      <Definition gml:id="XP_Rechtscharakter_4000">
         <description>Ziel der Raumordnung. Verbindliche räumliche und sachliche Festlegung zur Entwicklung, Ordnung und Sicherung des Raumes.</description>
         <identifier codeSpace="urn:xplan">XP_Rechtscharakter:4000</identifier>
         <name>ZielDerRaumordnung</name>
         <name codeSpace="lesbarerName">Ziel der Raumordnung</name>
      </Definition>
   </dictionaryEntry>
   <dictionaryEntry>
      <Definition gml:id="XP_Rechtscharakter_4100">
         <description>Grundsätze der Raumordnung sind nach §3 Abs. Aussagen zur Entwicklung, Ordnung und Sicherung des Raums als Vorgaben für nachfolgende Abwägungs- oder Ermessensentscheidungen. Grundsätze der Raumordnung können durch Gesetz oder Festlegungen in einem Raumordnungsplan (§7 Abs. 1 und 2, ROG) aufgestellt werden.</description>
         <identifier codeSpace="urn:xplan">XP_Rechtscharakter:4100</identifier>
         <name>GrundsatzDerRaumordnung</name>
         <name codeSpace="lesbarerName">Grundsatz der Raumordnung</name>
      </Definition>
   </dictionaryEntry>
   <dictionaryEntry>
