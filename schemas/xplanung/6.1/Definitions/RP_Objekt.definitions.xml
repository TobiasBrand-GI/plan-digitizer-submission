            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2534_7085_2530_7054">
               <gml:description>Vorzugsraum.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:RP_Objekt:gebietsTyp:1600</gml:identifier>
               <gml:name>Vorzugsraum</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2534_7085_2530_7055">
               <gml:description>Potenzialgebiet.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:RP_Objekt:gebietsTyp:1700</gml:identifier>
               <gml:name>Potenzialgebiet</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2534_7085_2530_7056">
               <gml:description>Schwerpunktraum.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:RP_Objekt:gebietsTyp:1800</gml:identifier>
               <gml:name>Schwerpunktraum</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2534_7085_2530_7057">
               <gml:description>Sonstiges Gebiet.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:RP_Objekt:gebietsTyp:9999</gml:identifier>
               <gml:name>SonstigesGebiet</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>0..*</def:cardinality>
         <def:valueTypeName>RP_GebietsTyp</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
