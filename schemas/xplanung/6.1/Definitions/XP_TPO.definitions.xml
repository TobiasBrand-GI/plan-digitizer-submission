<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type='text/xsl' href='./ShapeChangeDefinitionsType.xsl'?>
<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="2869"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Abstrakte Oberklasse für textliche Präsentationsobjekte. Entspricht der ALKIS Objektklasse AP_TPO</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:featureType:xplan::xplan:6.1:XP_TPO</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">XP_TPO</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2869_8855">
         <gml:description>Schriftinhalt; enthält den darzustellenden Text.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:schriftinhalt</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">schriftinhalt</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2869_8856">
         <gml:description>Die Zeichensperrung steuert den zusätzlichen Raum, der zwischen 2 aufeinanderfolgende Zeichenkörper geschoben wird. Er ist ein Faktor, der mit der angegebenen Zeichenhöhe multipliziert wird, um den einzufügenden Zusatzabstand zu erhalten. Mit der Abhängigkeit von der Zeichenhöhe wird erreicht, dass das Schriftbild unabhängig von der Zeichenhöhe gleich wirkt. Der Defaultwert ist 0.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:fontSperrung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">fontSperrung</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Decimal</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2869_9047">
         <gml:description>Individueller Skalierungsfaktor, der auf den aus dem Erstellungs-Maßstab abgeleiteten Faktor (Attribut erstellungsMassstab von XP_Plan) aufmultizipliert wird.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:skalierung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">skalierung</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Decimal</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2869_8858">
         <gml:description>Gibt die Ausrichtung des Textes bezüglich der Textgeometrie an.&#xD;
"linksbündig": Der Text beginnt an der Punktgeometrie bzw. am Anfangspunkt der Liniengeometrie.&#xD;
"rechtsbündig": Der Text endet an der Punktgeometrie bzw. am Endpunkt der Liniengeometrie&#xD;
"zentrisch": Der Text erstreckt sich von der Punktgeometrie gleich weit nach links und rechts bzw. steht auf der Mitte der Standlinie.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:horizontaleAusrichtung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">horizontaleAusrichtung</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2869_8858_2862_8842">
               <gml:description>Text linksbündig am Textpunkt bzw. am ersten Punkt der Linie.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:horizontaleAusrichtung:linksbündig</gml:identifier>
               <gml:name>linksbündig</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2869_8858_2862_8843">
               <gml:description>Text rechtsbündig am Textpunkt bzw. am letzten Punkt der Linie.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:horizontaleAusrichtung:rechtsbündig</gml:identifier>
               <gml:name>rechtsbündig</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2869_8858_2862_8844">
               <gml:description>Text zentriert am Textpunkt bzw. in der Mitte der Textstandlinie.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:horizontaleAusrichtung:zentrisch</gml:identifier>
               <gml:name>zentrisch</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>XP_HorizontaleAusrichtung</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2869_8859">
         <gml:description>Die vertikale Ausrichtung eines Textes gibt an, ob die Bezugsgeometrie die Basis (Grundlinie) des Textes, die Mitte oder obere Buchstabenbegrenzung betrifft.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:vertikaleAusrichtung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">vertikaleAusrichtung</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2869_8859_2863_8845">
               <gml:description>Textgeometrie bezieht sich auf die Basis- bzw. Grundlinie der Buchstaben.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:vertikaleAusrichtung:Basis</gml:identifier>
               <gml:name>Basis</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2869_8859_2863_8846">
               <gml:description>Textgeometrie bezieht sich auf die Mittellinie der Buchstaben.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:vertikaleAusrichtung:Mitte</gml:identifier>
               <gml:name>Mitte</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2869_8859_2863_8847">
               <gml:description>Textgeometrie bezieht sich auf die Oberlinie der Großbuchstaben.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:vertikaleAusrichtung:Oben</gml:identifier>
               <gml:name>Oben</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>XP_VertikaleAusrichtung</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="Tas1370">
         <gml:description>Die Relation ermöglicht es, einem textlichen Präsentationsobjekt ein linienförmiges Präsentationsobjekt zuzuweisen. Einziger bekannter Anwendungsfall ist der Zuordnungspfeil eines Symbols oder einer Nutzungsschablone.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_TPO:hat</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">hat</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:XP_LPO"/>
         <def:type>associationRole</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>featureType</def:classification>
   <def:supertypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:XP_AbstraktesPraesentationsobjekt"/>
</def:TypeDefinition>
