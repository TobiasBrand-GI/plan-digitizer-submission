                    gml:id="783"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Flächen und Leitungen für Versorgungsanlagen, für die Abfallentsorgung und Abwasserbeseitigung sowie für Ablagerungen (§9 Abs. 1, Nr. 12, 14 und Abs. 6 BauGB). Das gleiche Attribut darf nicht gleichzeitig in "BP_VerEntsorgung" und einem überlagernden Objekt "BP_UeberbaubareGrundstuecksFlaeche" belegt werden.</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:featureType:xplan::xplan:6.1:BP_VerEntsorgung</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">BP_VerEntsorgung</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="783_1800">
         <gml:description>Zweckbestimmung der Festsetzung..</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VerEntsorgung:zweckbestimmung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">zweckbestimmung</gml:name>
         <def:cardinality>0..*</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:BP_KomplexeZweckbestVerEntsorgung"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="783_1813">
         <gml:description>Angabe des Begünstigten der Ausweisung.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VerEntsorgung:zugunstenVon</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">zugunstenVon</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>featureType</def:classification>
   <def:supertypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:BP_Geometrieobjekt"/>
