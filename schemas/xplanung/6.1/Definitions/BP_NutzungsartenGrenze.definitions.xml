<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type='text/xsl' href='./ShapeChangeDefinitionsType.xsl'?>
<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="778"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Abgrenzung unterschiedlicher Nutzung, z.B. von Baugebieten wenn diese nach PlanzVO in der gleichen Farbe dargestellt werden, oder Abgrenzung unterschiedlicher Nutzungsmaße innerhalb eines Baugebiets ("Knödellinie", § 1 Abs. 4, § 16 Abs. 5 BauNVO).</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:featureType:xplan::xplan:6.1:BP_NutzungsartenGrenze</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">BP_NutzungsartenGrenze</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="778_3122">
         <gml:description>Typ der Abgrenzung. Wenn das Attribut nicht belegt ist, ist die Abgrenzung eine Nutzungsarten-Grenze (Schlüsselnummer 1000).</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_NutzungsartenGrenze:typ</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">typ</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="778_3122_1260_3120">
               <gml:description>Nutzungsarten-Grenze zur Abgrenzung von Baugebieten mit unterschiedlicher Art oder unterschiedlichem Maß der baulichen Nutzung.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_NutzungsartenGrenze:typ:1000</gml:identifier>
               <gml:name>Nutzungsartengrenze</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="778_3122_1260_7920">
               <gml:description>Abgrenzung von Bereichen mit unterschiedlichen Festsetzungen zur Gebäudehöhe und/oder Zahl der Vollgeschosse.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_NutzungsartenGrenze:typ:2000</gml:identifier>
               <gml:name>UnterschiedlicheHoehen</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="778_3122_1260_3121">
               <gml:description>Sonstige Abgrenzung</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_NutzungsartenGrenze:typ:9999</gml:identifier>
               <gml:name>SonstigeAbgrenzung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>BP_AbgrenzungenTypen</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="778_3123">
         <gml:description>Detaillierter Typ der Abgrenzung, wenn das Attribut "typ" den Wert 9999 (Sonstige Abgrenzung) hat.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_NutzungsartenGrenze:detailTyp</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">detailTyp</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>BP_DetailAbgrenzungenTypen</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>featureType</def:classification>
   <def:supertypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:BP_Linienobjekt"/>
</def:TypeDefinition>
