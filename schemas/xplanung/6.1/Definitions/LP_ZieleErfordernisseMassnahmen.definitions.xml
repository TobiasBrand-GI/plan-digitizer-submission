   <gml:description>Ziele, Erfordernisse und Maßnahmen für Naturschutz und Landschaftspflege gem. Kapitel 2 BNatSchG.</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:featureType:xplan::xplan:6.1:LP_ZieleErfordernisseMassnahmen</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">LP_ZieleErfordernisseMassnahmen</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2787_8477">
         <gml:description>Zeigt an, ob es sich bei dem Objekt um ein Ziel, ein Erfordernis und/oder um eine Maßnahme gemäß Kapitel 2 BNatSchG handelt.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_ZieleErfordernisseMassnahmen:zieleErfordernisseMassnahmen</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">zieleErfordernisseMassnahmen</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2787_8477_2789_8496">
               <gml:description>Zeigt an, dasses sich bei dem Objekt um ein für den Planungsraum konkretisiertes Ziel gemäß Kapitel 2 BNatSchG handelt.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_ZieleErfordernisseMassnahmen:zieleErfordernisseMassnahmen:1000</gml:identifier>
               <gml:name>Ziel</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2787_8477_2789_8497">
               <gml:description>Zeigt an, ob es sich bei dem Objekt um ein Erfordernis zur Verwirklichung der konkretisierten Ziele gemäß Kapitel 2 BNatSchG handelt. Erfordernisse sind Anforderungen an andere Fachplanungen und Landnutzungen (u. a. Wasserwirtschaft, Land- und Forstwirtschaft). Sie beschreiben, „welche planerischen oder praktischen Aktivitäten von anderen Planungsträgern im Rahmen ihres Mitwirkungsauftrages bei der Erfüllung der Ziele des Naturschutzes und der Landschaftspflege erwartet werden“ (§ 9 Abs. 3 und 5 BNatSchG).</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_ZieleErfordernisseMassnahmen:zieleErfordernisseMassnahmen:2000</gml:identifier>
               <gml:name>Erfordernis</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2787_8477_2789_8498">
               <gml:description>Zeigt an, ob es sich bei dem Objekt um eine Maßnahme zur Verwirklichung der konkretisierten Ziele gemäß Kapitel 2 BNatSchG handelt.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_ZieleErfordernisseMassnahmen:zieleErfordernisseMassnahmen:3000</gml:identifier>
               <gml:name>Massnahme</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1..*</def:cardinality>
         <def:valueTypeName>LP_ZEMTyp</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
