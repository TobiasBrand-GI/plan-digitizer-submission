<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="2756"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Vorschlag zur Integration in die Raumordnung</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_VorschlagIntegrationRaumordnung</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">LP_VorschlagIntegrationRaumordnung</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2756_8312">
         <gml:description>Begründung, warum die Landschaftsplanung die Übernahme in die Bauleitplanung vorschlägt / empfiehlt / festsetzt.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_VorschlagIntegrationRaumordnung:begruendung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">begruendung</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="Tas1340">
         <gml:description>Referenz auf ein Objekt im Modellbereich Raumordnung, das von der Landschaftsplanung als Kopiervorlage zur Übernahme in einen Raumordnungsplan vorgeschlagen wird.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_VorschlagIntegrationRaumordnung:refObjektRaumordnung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">refObjektRaumordnung</gml:name>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:XP_Objekt"/>
         <def:type>associationRole</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>dataType</def:classification>
</def:TypeDefinition>
