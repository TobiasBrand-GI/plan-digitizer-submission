   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2881_8922">
         <gml:description>Nummer (Attribut "nummer" von "XP_Bereich") des verbundenen Planbereiches.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlanBereich:bereichNummer</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">bereichNummer</gml:name>
         <def:cardinality>0..1</def:cardinality>
