         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="Tas1380">
         <gml:description>Referenz auf einen verbundenen Planbereich, der den aktuellen Plan oder Planbereich ändert oder von ihm geändert wird.</gml:description>
