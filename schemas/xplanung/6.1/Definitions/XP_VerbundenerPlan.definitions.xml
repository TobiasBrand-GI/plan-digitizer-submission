<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type='text/xsl' href='./ShapeChangeDefinitionsType.xsl'?>
<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="624"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Spezifikation eines anderen Plans, der mit dem Ausgangsplan oder Planbereich verbunden ist und diesen ändert bzw. von ihm geändert wird.</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:dataType:xplan::xplan:6.1:XP_VerbundenerPlan</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">XP_VerbundenerPlan</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="624_1034">
         <gml:description>Name (Attribut "name" von "XP_Plan") des verbundenen Plans.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:planName</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">planName</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="624_1035">
         <gml:description>Spezifikation der Art der Änderungsbeziehung zwischen den verbundenen Plan- bzw. Planbereichs-Objekten.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">aenderungsArt</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="624_1035_621_8921">
               <gml:description>Einzelne Planinhalte im Planungsbereich werden durch neue Inhalte ersetzt, neue Inhalte werden ergänzt, bestehen Inhalte werden gestrichen oder bleiben erhalten.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt:1000</gml:identifier>
               <gml:name>Aenderung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="624_1035_621_1001">
               <gml:description>Einzelne Planinhalte im Planungsbereich werden durch neue Inhalte ersetzt.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt:10000</gml:identifier>
               <gml:name>Ersetzung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="624_1035_621_1002">
               <gml:description>Alle bestehenden Inhalte bleiben erhalten, und es werden neue Inhalte ergänzt.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt:10001</gml:identifier>
               <gml:name>Ergaenzung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="624_1035_621_8919">
               <gml:description>Einzelne Planinhalte im Planungsbereich werden ersatzlos gestrichen.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt:10002</gml:identifier>
               <gml:name>Streichung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="624_1035_621_8920">
               <gml:description>Alle Inhalte des geänderten Plans im Geltungsbereich des ändernden Plans werden ersatzlos außer Kraft gesetzt.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt:2000</gml:identifier>
               <gml:name>Aufhebung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="624_1035_621_8142">
               <gml:description>Alle Inhalte des geänderten Plans im Geltungsbereich des ändernden Plans werden außer Kraft gesetzt und durch die neuen Inhalte ersetzt.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsArt:3000</gml:identifier>
               <gml:name>Ueberplanung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>XP_Aenderungsarten</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="624_1036">
         <gml:description>Nummer (Attribut "nummer" von "XP_Plan") des verbundenen Plans</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:nummer</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">nummer</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="624_8923">
         <gml:description>Datum, an dem die Änderung in Kraft getreten ist. Das Attribut muss mit dem Datum des Inkrafttretens des ändernden Plans konsistent sein.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:aenderungsdatum</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">aenderungsdatum</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Date</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="Tas1250">
         <gml:description>Referenz auf einen verbundenen Plan, der den aktuellen Plan oder Planbereich ändert oder von ihm geändert wird.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_VerbundenerPlan:verbundenerPlan</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">verbundenerPlan</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:XP_Plan"/>
         <def:type>associationRole</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>dataType</def:classification>
</def:TypeDefinition>
