<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type='text/xsl' href='./ShapeChangeDefinitionsType.xsl'?>
<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="2731"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Spezifikation der Daten für eine Veränderungssperre</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:dataType:xplan::xplan:6.1:BP_VeraenderungssperreDaten</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">BP_VeraenderungssperreDaten</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2731_8249">
         <gml:description>Datum, ab dem die Veränderungssperre gilt</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:startDatum</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">startDatum</gml:name>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>Date</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2731_8250">
         <gml:description>Enddatum der Veränderungssperre</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:endDatum</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">endDatum</gml:name>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>Date</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2731_8251">
         <gml:description>Gibt an, ob die Veränderungssperre bereits ein- oder zweimal verlängert wurde</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:verlaengerung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">verlaengerung</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2731_8251_639_1216">
               <gml:description>Veränderungssperre wurde noch nicht verlängert.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:verlaengerung:1000</gml:identifier>
               <gml:name>Keine</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2731_8251_639_1217">
               <gml:description>Veränderungssperre wurde einmal verlängert.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:verlaengerung:2000</gml:identifier>
               <gml:name>ErsteVerlaengerung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2731_8251_639_1218">
               <gml:description>Veränderungssperre wurde zweimal verlängert.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:verlaengerung:3000</gml:identifier>
               <gml:name>ZweiteVerlaengerung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>BP_VerlaengerungVeraenderungssperre</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2731_8252">
         <gml:description>Beschlussdatum der Veränderungssperre</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:beschlussDatum</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">beschlussDatum</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Date</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2731_8253">
         <gml:description>Referenz auf das Dokument des Veränderungssperre-Beschlusses.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_VeraenderungssperreDaten:refBeschluss</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">refBeschluss</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:XP_ExterneReferenz"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>dataType</def:classification>
</def:TypeDefinition>
