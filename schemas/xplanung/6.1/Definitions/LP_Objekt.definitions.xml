<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type='text/xsl' href='./ShapeChangeDefinitionsType.xsl'?>
<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="2767"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Basisklasse für alle spezifischen Inhalte eines Landschaftsplans.</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:featureType:xplan::xplan:6.1:LP_Objekt</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">LP_Objekt</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2767_8362">
         <gml:description>Beschreibung der räumlichen Schärfe des geometrischen Objekts, d.h. wie konkret die Geometrie in Attribut "position" die tatsächliche räumliche Gestalt des Planinhalts darstellt.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">raumkonkretisierung</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2767_8362_2754_8305">
               <gml:description>Scharf abgegrenzte Fläche bzw. eine im Erfassungsmaßstab des Plans sinnvollerweise als Linien- oder Punktobjekt erfassbare scharfe Geometrie.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung:1000</gml:identifier>
               <gml:name>Scharf</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2767_8362_2754_8306">
               <gml:description>Suchraum (die Maßnahme/Planung bzw. bezieht sich auf Teilbereiche innerhalb der Gesamtfläche)</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung:2000</gml:identifier>
               <gml:name>Suchraum</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2767_8362_2754_8307">
               <gml:description>Fließende Grenzen, mit Übergangsbereichen.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung:3000</gml:identifier>
               <gml:name>Unscharf</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2767_8362_2754_8308">
               <gml:description>Markierung durch eine vereinfachte Geometrie ohne konkrete Festlegung der tatsächlichen räumlichen Ausdehnung; meist als Geometrietyp Punkt oder Linie); für diese Stelle liegt eine Information vor, die genaue räumliche Ausdehnung über diese Geometrie hinaus ist unklar.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung:4000</gml:identifier>
               <gml:name>Position</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2767_8362_2754_8309">
               <gml:description>Raumunkonkret (keine räumlich belastbaren oder nur textliche Informationen zum gemeinten Raum, z.B. „naturfern verbaute Teilabschnitte der Bäche und Fließgewässer im Plangebiet“); möglicherweise  ganz ohne Darstellung in der Planzeichnung.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung:5000</gml:identifier>
               <gml:name>Raumunkonkret</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2767_8362_2754_8310">
               <gml:description>Unbekannt (keine Einordnung möglich, z.B. zur Übernahme von Alt-Plänen, in denen der Grad der Raumkonkretisierung erkennbar / nicht mehr recherchierbar ist.)</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:raumkonkretisierung:9998</gml:identifier>
               <gml:name>Unbekannt</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>LP_Raumkonkretisierung</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2767_8364">
         <gml:description>Textliche Konkretisierung der rechtlichen Charakterisierung.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:rechtsCharText</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">rechtsCharText</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2767_8365">
         <gml:description>Verweis auf ein Objekt im Modellbereich Bauleitplanung, das von der Landschaftsplanung als Kopiervorlage zur Übernahme in den FNP/Bebauungsplan vorgeschlagen wird. Referenziert ein Objekt mit Angabe der Begründung.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:vorschlagIntegrationBLP</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">vorschlagIntegrationBLP</gml:name>
         <def:cardinality>0..*</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_VorschlagIntegrationBauleitplanung"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2767_8366">
         <gml:description>Verweis auf ein Objekt im Modellbereich Raumordnung, das von der Landschaftsplanung als Kopiervorlage zur Übernahme in den Raumordnungsplan vorgeschlagen wird. Referenziert ein Objekt mit Angabe der Begründung.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:vorschlagIntegrationRO</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">vorschlagIntegrationRO</gml:name>
         <def:cardinality>0..*</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_VorschlagIntegrationRaumordnung"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2767_8367">
         <gml:description>Angaben zu einem anderen LP-Planinhalt, der mit diesem LP-Objekt in Verbindung steht.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:referenziertLPObjekt</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">referenziertLPObjekt</gml:name>
         <def:cardinality>0..*</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_ReferenzLPObjekt"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2767_8368">
         <gml:description>Rückwärtsreferenz zu einem LP- Objekt, das dieses LP-Objekt referenziert.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Objekt:wirdReferenziertVon</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">wirdReferenziertVon</gml:name>
         <def:cardinality>0..*</def:cardinality>
         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_ReferenzLPObjekt"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>featureType</def:classification>
   <def:supertypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:XP_Objekt"/>
</def:TypeDefinition>
