               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Nutzungsbeschraenkung:technVorkehrung:9999</gml:identifier>
