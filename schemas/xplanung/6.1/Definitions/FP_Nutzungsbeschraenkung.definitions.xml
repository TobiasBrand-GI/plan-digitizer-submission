   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">FP_Nutzungsbeschraenkung</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="852_8258">
         <gml:description>Festgesetzte Nutzung der Fläche</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Nutzungsbeschraenkung:nutzung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">nutzung</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="852_8259">
         <gml:description>Differenzierung der Fläche gemäß BauGB</gml:description>
