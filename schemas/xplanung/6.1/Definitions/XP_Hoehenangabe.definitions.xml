         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">abweichenderHoehenbezug</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
