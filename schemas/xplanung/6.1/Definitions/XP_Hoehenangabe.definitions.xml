   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="618_8880">
         <gml:description>Das Attribut spezifiziert  oder ergänzt den Bezug des Höhenbezugspunktes (insbesondere der Traufhöhe), z. B. als "bergseitig, "talseitig", "straßenseitig" oder "gartenseitig".</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_Hoehenangabe:bezugspunktText</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">bezugspunktText</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>CharacterString</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="618_968">
         <gml:description>Minimal zulässige Höhe des Bezugspunktes (bezugspunkt) bei einer Bereichsangabe, bzw. untere Grenze des vertikalen Gültigkeitsbereiches eines Planinhalts, wenn "bezugspunkt" nicht belegt ist. In diesem Fall gilt: Ist  "hMax" nicht belegt, gilt die Festlegung ab der Höhe "hMin".</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_Hoehenangabe:hMin</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">hMin</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Length</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="618_969">
         <gml:description>Maximal zulässige Höhe des Bezugspunktes (bezugspunkt) bei einer Bereichsangabe, bzw. obere Grenze des vertikalen Gültigkeitsbereiches eines Planinhalts, wenn "bezugspunkt" nicht belegt ist.  In diesem Fall gilt: Ist  "hMin" nicht belegt, gilt die Festlegung bis zur Höhe "hMax".</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_Hoehenangabe:hMax</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">hMax</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Length</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="618_970">
         <gml:description>Zwingend einzuhaltende Höhe des Bezugspunktes (bezugspunkt) , bzw. Beschränkung der vertikalen Gültigkeitsbereiches eines Planinhalts auf eine bestimmte Höhe.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_Hoehenangabe:hZwingend</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">hZwingend</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Length</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="618_971">
         <gml:description>Maximal zulässige Höhe des Bezugspunktes (bezugspunkt) .</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:XP_Hoehenangabe:h</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">h</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Length</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
