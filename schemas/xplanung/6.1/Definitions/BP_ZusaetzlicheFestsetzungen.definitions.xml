   <gml:description>Zusätzliche Festsetzungen für die überbaubare Grundstücksfläche</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:mixinType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">BP_ZusaetzlicheFestsetzungen</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2638_7804">
         <gml:description>Festsetzung nach §6a Abs. (4) Nr. 1 BauNVO: Für urbane Gebiete oder Teile solcher Gebiete kann festgesetzt werden, dass in Gebäuden &#xD;
im Erdgeschoss an der Straßenseite eine Wohnnutzung nicht oder nur ausnahmsweise zulässig ist.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen:wohnnutzungEGStrasse</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">wohnnutzungEGStrasse</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2638_7804_716_1504">
               <gml:description>Generelle Zulässigkeit</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen:wohnnutzungEGStrasse:1000</gml:identifier>
               <gml:name>Zulaessig</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2638_7804_716_1505">
               <gml:description>Generelle Nicht-Zulässigkeit.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen:wohnnutzungEGStrasse:2000</gml:identifier>
               <gml:name>NichtZulaessig</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2638_7804_716_1506">
               <gml:description>Ausnahmsweise Zulässigkeit</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen:wohnnutzungEGStrasse:3000</gml:identifier>
               <gml:name>AusnahmsweiseZulaessig</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>BP_Zulaessigkeit</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2638_7805">
         <gml:description>Festsetzung nach §4a Abs. (4) Nr. 1 bzw. nach  §6a Abs. (4) Nr. 2 BauNVO: Für besondere Wohngebiete und  urbane Gebiete oder Teile solcher Gebiete kann festgesetzt werden, dass in Gebäuden oberhalb eines im Bebauungsplan bestimmten Geschosses nur Wohnungen zulässig sind.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen:ZWohn</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">ZWohn</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Integer</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2638_7806">
         <gml:description>Festsetzung nach §4a Abs. (4) Nr. 2 bzw. §6a Abs. (4) Nr. 3 BauNVO: Für besondere Wohngebiete und urbane Gebiete oder Teile solcher Gebiete kann festgesetzt werden, dass &#xD;
in Gebäuden ein im Bebauungsplan bestimmter Anteil der zulässigen &#xD;
Geschossfläche für Wohnungen zu verwenden ist.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_ZusaetzlicheFestsetzungen:GFAntWohnen</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">GFAntWohnen</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Scale</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2638_7807">
         <gml:description>Festsetzung nach §4a Abs. (4) Nr. 2 bzw. §6a Abs. (4) Nr. 3 BauNVO: Für besondere Wohngebiete und urbane Gebiete oder Teile solcher Gebiete kann festgesetzt werden, dass &#xD;
in Gebäuden eine im Bebauungsplan bestimmte Größe der Geschossfläche für Wohnungen zu verwenden ist.</gml:description>
