   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">RP_Wasserwirtschaft</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2578_7354">
