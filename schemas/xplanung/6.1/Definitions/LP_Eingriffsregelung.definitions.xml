            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2774_8431_2782_8459">
               <gml:description>Vorschlag von Kompensationsflächen und -maßnahmen.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Eingriffsregelung:umsetzungsstand:2000</gml:identifier>
