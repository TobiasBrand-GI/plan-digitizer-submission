               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Eingriffsregelung:massnahmentyp:3000</gml:identifier>
               <gml:name>MassnahmeFCS</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2774_8432_2778_8447">
               <gml:description>Maßnahme zur Kohärenzsicherung im Rahmen der FFH-Verträglichkeitsprüfung.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Eingriffsregelung:massnahmentyp:4000</gml:identifier>
               <gml:name>MassnahmeKohaerenzsicherung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2774_8432_2778_8448">
