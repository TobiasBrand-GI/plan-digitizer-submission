         <def:valueTypeRef xlink:href="urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_EingriffsregelungKomplex"/>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2774_8431">
         <gml:description>Zeigt an, ob eine bereit umgesetzte oder angerechnete Kompensationsfläche oder -Maßnahme nachrichtlich übernommen oder für neue Kompensationsmaßenahmen vorgeschlagen wird.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Eingriffsregelung:umsetzungsstand</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">umsetzungsstand</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2774_8431_2782_8458">
               <gml:description>Nachrichtliche Übernahme von Kompensationsflächen und -maßnahmen aus vorliegenden Planwerken, die bereits umgesetzt oder angerechnet wurden.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Eingriffsregelung:umsetzungsstand:1000</gml:identifier>
