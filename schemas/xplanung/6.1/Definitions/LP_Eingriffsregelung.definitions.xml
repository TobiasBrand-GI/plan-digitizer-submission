            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2774_8431_2782_8460">
               <gml:description>Unbekannter Umsetzungsstand (bei Übernahme von Altdaten).</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_Eingriffsregelung:umsetzungsstand:9998</gml:identifier>
