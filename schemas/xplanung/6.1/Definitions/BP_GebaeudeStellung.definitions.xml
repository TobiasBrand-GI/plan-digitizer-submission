<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type='text/xsl' href='./ShapeChangeDefinitionsType.xsl'?>
<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="739"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Gestaltungs-Festsetzung der Firstrichtung, oder Dach-Ausrichtung, beruhend auf Landesrecht, gemäß  §9 Abs. 4 BauGB.</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:featureType:xplan::xplan:6.1:BP_GebaeudeStellung</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">BP_GebaeudeStellung</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="739_8272">
         <gml:description>Angabe, auf welche Art und Weise die Stellung des Gebäudes spezifiziert wird.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_GebaeudeStellung:typ</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">typ</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="739_8272_2733_8269">
               <gml:description>Spezifikation der Firstlinie</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_GebaeudeStellung:typ:1000</gml:identifier>
               <gml:name>Firstrichtung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="739_8272_2733_8270">
               <gml:description>Spezifikation einer gerichteten Linie von der Dachtraufe zum Dachfirst.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_GebaeudeStellung:typ:2000</gml:identifier>
               <gml:name>Dachneigungsrichtung</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="739_8272_2733_8271">
               <gml:description>Der Code wird nur verwendet, wenn bei den geplanten Gebäuden keine eindeutige Firstrichtung identifizierbar ist. Die spezifizierte Linie gibt in diesem Fall die räumliche Ausrichtung des Haupt-Baukörpers an.</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:BP_GebaeudeStellung:typ:3000</gml:identifier>
               <gml:name>StellungBaulAnlagen</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>BP_GebaeudeStellungTypen</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <def:classification>featureType</def:classification>
   <def:supertypeRef xlink:href="urn:x-shapechange:def:featureType:xplan::xplan:6.1:BP_Linienobjekt"/>
</def:TypeDefinition>
