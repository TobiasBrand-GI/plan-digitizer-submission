            <def:ListedValueDefinition gml:id="2799_8630_106_102">
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_BiologischeVielfaltKomplex:bioVfArtFFHAnhangII:0</gml:identifier>
               <gml:name>FALSE</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>Boolean</def:valueTypeName>
         <def:type>attribute</def:type>
