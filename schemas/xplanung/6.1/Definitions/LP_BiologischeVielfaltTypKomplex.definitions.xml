            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2785_8473_2808_8664">
               <gml:description>Zielbiotop (Lebensraum)</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_BiologischeVielfaltTypKomplex:bioVielfaltTyp:2000</gml:identifier>
               <gml:name>BiotopLebensraum</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2785_8473_2808_8665">
               <gml:description>Lebensstätte (Arthabitat)</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_BiologischeVielfaltTypKomplex:bioVielfaltTyp:4000</gml:identifier>
               <gml:name>LebensstaetteArthabitat</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2785_8473_2808_8666">
               <gml:description>Sonstiger Bestandteil Biologische Vielfalt (siehe bioVielfaltTypText)</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_BiologischeVielfaltTypKomplex:bioVielfaltTyp:9999</gml:identifier>
               <gml:name>Sonstiges</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>1</def:cardinality>
         <def:valueTypeName>LP_BioVfBestandteil</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
