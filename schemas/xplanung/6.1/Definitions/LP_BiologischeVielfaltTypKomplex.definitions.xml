<def:TypeDefinition xmlns:def="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5"
                    xmlns:gml="http://www.opengis.net/gml/3.2"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    gml:id="2785"
                    xsi:schemaLocation="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5 ShapeChangeDefinitions.xsd">
   <gml:description>Angaben, auf welchen Bestandteil / Typus der Biologischen Vielfalt sich das Objekt bezieht:</gml:description>
   <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:dataType:xplan::xplan:6.1:LP_BiologischeVielfaltTypKomplex</gml:identifier>
   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">LP_BiologischeVielfaltTypKomplex</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="2785_8473">
         <gml:description>Zeigt an, auf welchen Bestandteil der Biologischen Vielfalt sich das Objekt bezieht:</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_BiologischeVielfaltTypKomplex:bioVielfaltTyp</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">bioVielfaltTyp</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="2785_8473_2808_8663">
               <gml:description>Zielart</gml:description>
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:LP_BiologischeVielfaltTypKomplex:bioVielfaltTyp:1000</gml:identifier>
