   <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">FP_Objekt</gml:name>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="825_1897">
         <gml:description>Über eine Codeliste definierte spezifische bauliche Prägung einer Darstellung.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Objekt:spezifischePraegung</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">spezifischePraegung</gml:name>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>FP_SpezifischePraegungTypen</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="825_8145">
         <gml:description>Angabe, ob Teile des Flächennutzungsplans nach §6 Abs. 3 BauGB von der Genehmigung ausgenommen sind</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Objekt:vonGenehmigungAusgenommen</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">vonGenehmigungAusgenommen</gml:name>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="825_8145_106_101">
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Objekt:vonGenehmigungAusgenommen:1</gml:identifier>
               <gml:name>TRUE</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <gml:dictionaryEntry>
            <def:ListedValueDefinition gml:id="825_8145_106_102">
               <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Objekt:vonGenehmigungAusgenommen:0</gml:identifier>
               <gml:name>FALSE</gml:name>
            </def:ListedValueDefinition>
         </gml:dictionaryEntry>
         <def:cardinality>0..1</def:cardinality>
         <def:valueTypeName>Boolean</def:valueTypeName>
         <def:type>attribute</def:type>
      </def:PropertyDefinition>
   </gml:dictionaryEntry>
   <gml:dictionaryEntry>
      <def:PropertyDefinition gml:id="Tas941">
         <gml:description>Referenz auf eine Ausgleichsfläche, die den Eingriff ausgleicht.&#xD;
Die Relation ist veraltet und wird in Version 7 wegfallen. Stattdessen sollte die Relation wirdAusgeglichenDurchSPE verwendet werden.</gml:description>
         <gml:identifier codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5">urn:x-shapechange:def:propertyType:xplan::xplan:6.1:FP_Objekt:wirdAusgeglichenDurchFlaeche</gml:identifier>
         <gml:name codeSpace="http://www.interactive-instruments.de/ShapeChange/Definitions/0.5/name">wirdAusgeglichenDurchFlaeche</gml:name>
