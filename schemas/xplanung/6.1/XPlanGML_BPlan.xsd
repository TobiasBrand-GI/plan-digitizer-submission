                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xplan:BP_AnpflanzungBindungErhaltung</targetElement>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="wirdAusgeglichenDurchSPEMassnahme"
                        type="gml:ReferenceType">
