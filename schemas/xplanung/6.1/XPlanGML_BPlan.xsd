                  </annotation>
               </element>
               <element minOccurs="0"
                        name="plangeber"
                        type="xplan:XP_PlangeberPropertyType">
                  <annotation>
                     <documentation>Für den Plan verantwortliche Stelle.</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded" name="planArt" type="xplan:BP_PlanArtType">
