                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xplan:BP_ZusatzkontingentLaerm</targetElement>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="zusatzkontingentFlaeche"
                        type="gml:ReferenceType">
