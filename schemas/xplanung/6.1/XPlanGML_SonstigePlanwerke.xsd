<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:gml="http://www.opengis.net/gml/3.2"
        xmlns:xplan="http://www.xplanung.de/xplangml/6/1"
        elementFormDefault="qualified"
        targetNamespace="http://www.xplanung.de/xplangml/6/1"
        version="6.1">
   <annotation>
      <documentation>Fachschema zur Modellierung Planart-übergreifender Inhalte, nachrichtlicher Übernahmen aus anderen Rechtsbereichen und sonstiger raumbezogener Pläne nach BauGB.</documentation>
   </annotation>
   <include schemaLocation="XPlanGML.xsd"/>
   <include schemaLocation="XPlanGML_BPlan.xsd"/>
   <include schemaLocation="XPlanGML_Basisschema.xsd"/>
   <import namespace="http://www.opengis.net/gml/3.2"
           schemaLocation="GmlProfile/gmlProfilexplan.xsd"/>
   <element name="SO_Baubeschraenkung"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_BaubeschraenkungType">
      <annotation>
         <documentation>Bereich, in denen Verbote oder Beschränkungen für die Errichtung baulicher Anlagen bestehen</documentation>
      </annotation>
   </element>
   <complexType name="SO_BaubeschraenkungType">
      <complexContent>
         <extension base="xplan:SO_GeometrieobjektType">
            <sequence>
               <element minOccurs="0"
                        name="artDerFestlegung"
                        type="xplan:SO_KlassifizBaubeschraenkungType">
                  <annotation>
                     <documentation>Klassifizierung des Bauverbots bzw. der Baubeschränkung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="detailArtDerFestlegung" type="gml:CodeType">
                  <annotation>
                     <documentation>Detaillierte Klassifizierung des Bauverbots bzw. der Baubeschränkung über eine Codeliste</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_DetailKlassifizBaubeschraenkung</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="rechtlicheGrundlage"
                        type="xplan:SO_RechtlicheGrundlageBaubeschraenkungType">
                  <annotation>
                     <documentation>Rechtliche Grundlage des Bauverbots bzw. der Baubeschränkung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="name" type="string">
                  <annotation>
                     <documentation>Informelle bezeichnung der Festlegung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Amtliche Bezeichnung / Kennziffer der Festlegung</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Bereich"
            substitutionGroup="xplan:XP_Bereich"
            type="xplan:SO_BereichType">
      <annotation>
         <documentation>Bereich eines sonstigen raumbezogenen Plans.</documentation>
      </annotation>
   </element>
   <complexType name="SO_BereichType">
      <complexContent>
         <extension base="xplan:XP_BereichType">
            <sequence>
               <element name="gehoertZuPlan" type="gml:ReferenceType">
                  <annotation>
                     <documentation>Referenz auf den Plan, zu dem der Bereich gehört</documentation>
                     <appinfo>
                        <targetElement xmlns="http://www.opengis.net/gml/3.2">xplan:SO_Plan</targetElement>
                        <reversePropertyName xmlns="http://www.opengis.net/gml/3.2">xplan:bereich</reversePropertyName>
                     </appinfo>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Bodenschutzrecht"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_BodenschutzrechtType">
      <annotation>
         <documentation>Festlegung nach Bodenschutzrecht.</documentation>
      </annotation>
   </element>
   <complexType name="SO_BodenschutzrechtType">
      <complexContent>
         <extension base="xplan:SO_GeometrieobjektType">
            <sequence>
               <element minOccurs="0"
                        name="artDerFestlegung"
                        type="xplan:SO_KlassifizNachBodenschutzrechtType">
                  <annotation>
                     <documentation>Klassifizierung der Festlegung.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="detailArtDerFestlegung" type="gml:CodeType">
                  <annotation>
                     <documentation>Über eine Codeliste definierte detailliertere Klassifizierung der Festlegung.</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_DetailKlassifizNachBodenschutzrecht</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element default="false"
                        minOccurs="0"
                        name="istVerdachtsflaeche"
                        type="boolean">
                  <annotation>
                     <documentation>Angabe ob es sich um eine Verdachtsfläche handelt.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="name" type="string">
                  <annotation>
                     <documentation>Informelle Bezeichnung der Festlegung.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Amtliche Bezeichnung / Kennziffer der Festlegung. bzw. Nummer in einem Altlast-Kataster</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Denkmalschutzrecht"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_DenkmalschutzrechtType">
      <annotation>
         <documentation>Festlegung nach Denkmalschutzrecht</documentation>
      </annotation>
   </element>
   <complexType name="SO_DenkmalschutzrechtType">
      <complexContent>
         <extension base="xplan:SO_GeometrieobjektType">
            <sequence>
               <element minOccurs="0"
                        name="artDerFestlegung"
                        type="xplan:SO_KlassifizNachDenkmalschutzrechtType">
                  <annotation>
                     <documentation>Rechtliche Klassifizierung der Festlegung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="detailArtDerFestlegung" type="gml:CodeType">
                  <annotation>
                     <documentation>Über eine Codeliste definierte detailliertere rechtliche Klassifizierung der Festlegung.</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_DetailKlassifizNachDenkmalschutzrecht</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element default="false"
                        minOccurs="0"
                        name="weltkulturerbe"
                        type="boolean">
                  <annotation>
                     <documentation>Gibt an, ob das geschützte Objekt zum Weltkulturerbe gehört.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="name" type="string">
                  <annotation>
                     <documentation>Informelle Bezeichnung der Festlegung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Amtliche Bezeichnung / Kennziffer der Festlegung.</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Festpunkt"
            substitutionGroup="xplan:SO_Punktobjekt"
            type="xplan:SO_FestpunktType">
      <annotation>
         <documentation>Modelliert Höhenfestpunkte und kombinierte Lage- und Höhenfestpunkte, wobei die Höhe über das Attribut  "hoehenangabe" (XP_Hoehenangabe) spezifiziert wird.</documentation>
      </annotation>
   </element>
   <complexType name="SO_FestpunktType">
      <complexContent>
         <extension base="xplan:SO_PunktobjektType">
            <sequence>
               <element name="typ" type="xplan:SO_FestpunktTypType">
                  <annotation>
                     <documentation>Typ des Festpunktes</documentation>
                  </annotation>
               </element>
               <element name="bezeichnung" type="string">
                  <annotation>
                     <documentation>Bezeichnung des Festpunktes</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="messzeitpunkt" type="date">
                  <annotation>
                     <documentation>Aufnahme-Zeitpunkt</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <simpleType name="SO_FestpunktTypType">
      <restriction base="string">
         <enumeration value="1000">
            <annotation>
               <documentation>Höhenfestpunkt</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2000">
            <annotation>
               <documentation>Kombinierter Lage- und Höhenfestpunkt</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <element abstract="true"
            name="SO_Flaechenobjekt"
            substitutionGroup="xplan:SO_Objekt"
            type="xplan:SO_FlaechenobjektType">
      <annotation>
         <documentation>Basisklasse für alle Objekte mit flächenhaftem Raumbezug (eine Einzelfläche oder eine Menge von Flächen, die sich nicht überlappen dürfen).</documentation>
      </annotation>
   </element>
   <complexType abstract="true" name="SO_FlaechenobjektType">
      <complexContent>
         <extension base="xplan:SO_ObjektType">
            <sequence>
               <element name="position" type="gml:GeometryPropertyType">
                  <annotation>
                     <documentation>Flächenhafter Raumbezug des Objektes (Eine Einzelfläche oder eine Menge von Flächen, die sich nicht überlappen dürfen).</documentation>
                  </annotation>
               </element>
               <element name="flaechenschluss" type="boolean">
                  <annotation>
                     <documentation>Zeigt an, ob das Objekt als Flächenschlussobjekt oder Überlagerungsobjekt gebildet werden soll. Flächenschlussobjekte dürfen sich nicht überlappen, sondern nur an den Flächenrändern berühren, wobei die jeweiligen Stützpunkte der Randkurven übereinander liegen müssen. Die Vereinigung der Flächenschlussobjekte überdeckt den Geltungsbereich des sonstigen raumbezogenen Plans vollständig.</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Forstrecht"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_ForstrechtType">
      <annotation>
         <documentation>Festlegung nach Forstrecht</documentation>
      </annotation>
   </element>
   <complexType name="SO_ForstrechtType">
      <complexContent>
         <extension base="xplan:SO_GeometrieobjektType">
            <sequence>
               <element minOccurs="0"
                        name="artDerFestlegung"
                        type="xplan:XP_EigentumsartWaldType">
                  <annotation>
                     <documentation>Klassifizierung der Eigentumsart des Waldes.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="detailArtDerFestlegung" type="gml:CodeType">
                  <annotation>
                     <documentation>Über eine Codeliste definierte detailliertere Klassifizierung der Eigentumsart des Waldes</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_DetailKlassifizNachForstrecht</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="funktion"
                        type="xplan:XP_ZweckbestimmungWaldType">
                  <annotation>
                     <documentation>Klassifizierung der Fukktion des Waldes</documentation>
                  </annotation>
               </element>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="betreten"
                        type="xplan:XP_WaldbetretungTypType">
                  <annotation>
                     <documentation>Festlegung zusätzlicher, normalerweise nicht-gestatteter Aktivitäten, die in dem Wald ausgeführt werden dürfen, nach §14 Abs. 2 Bundeswaldgesetz.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="name" type="string">
                  <annotation>
                     <documentation>Informelle Bezeichnung der Festlegung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Amtliche Bezeichnung / Kennziffer der Festlegung</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Gebiet"
            substitutionGroup="xplan:SO_Flaechenobjekt"
            type="xplan:SO_GebietType">
      <annotation>
         <documentation>Umgrenzung eines sonstigen Gebietes nach BauGB</documentation>
      </annotation>
   </element>
   <complexType name="SO_GebietType">
      <complexContent>
         <extension base="xplan:SO_FlaechenobjektType">
            <sequence>
               <element minOccurs="0" name="gemeinde" type="xplan:XP_GemeindePropertyType">
                  <annotation>
                     <documentation>Zuständige Gemeinde</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="gebietsArt" type="xplan:SO_GebietsArtType">
                  <annotation>
                     <documentation>Klassifikation des Gebietes nach BauGB.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="sonstGebietsArt" type="gml:CodeType">
                  <annotation>
                     <documentation>Über eine Codeliste definierte Klassifikation einer nicht auf dem BauGB beruhenden, z.B. länderspezifischen Gebietsausweisung. In dem Fall muss das Attribut "gebietsArt" den Wert 9999 (Sonstiges) haben.</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_SonstGebietsArt</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element minOccurs="0"
                        name="rechtsstandGebiet"
                        type="xplan:SO_RechtsstandGebietTypType">
                  <annotation>
                     <documentation>Rechtsstand der Gebietsausweisung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="sonstRechtsstandGebiet" type="gml:CodeType">
                  <annotation>
                     <documentation>Über eine Codeliste definierter sonstiger Rechtsstand der Gebietsausweisung, der nicht durch die Liste SO_RechtsstandGebietTyp wiedergegeben werden kann. Das Attribut "rechtsstandGebiet" muss in diesem Fall den Wert 9999 (Sonstiges) haben.</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_SonstRechtsstandGebietTyp</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element minOccurs="0" name="aufstellungsbeschhlussDatum" type="date">
                  <annotation>
                     <documentation>Datum des Aufstellungsbeschlusses</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="durchfuehrungStartDatum" type="date">
                  <annotation>
                     <documentation>Start-Datum der Durchführung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="durchfuehrungEndDatum" type="date">
                  <annotation>
                     <documentation>End-Datum der Durchführung</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="traegerMassnahme" type="string">
                  <annotation>
                     <documentation>Maßnahmen-Träger</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <simpleType name="SO_GebietsArtType">
      <annotation>
         <documentation>Aufzählung von Gebietsausweisungen nach BauGB</documentation>
      </annotation>
      <restriction base="string">
         <enumeration value="1000">
            <annotation>
               <documentation>Umlegungsgebiet (§ 45 ff BauGB).</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1100">
            <annotation>
               <documentation>Gebiet nach § 136 ff BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1200">
            <annotation>
               <documentation>Gebiet nach § 165 ff BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1300">
            <annotation>
               <documentation>Gebiet nach § 171 a-d BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1400">
            <annotation>
               <documentation>Gebiet nach § 171 e BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1500">
            <annotation>
               <documentation>Gebiet nach §171 f BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1600">
            <annotation>
               <documentation>Gebiet nach §171 f BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="1700">
            <annotation>
               <documentation>Allgemeines Erhaltungsgebiet nach §172 BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="17000">
            <annotation>
               <documentation>Gebiet einer Satzung/Verordnung nach § 172 Abs. 1.1 BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="17001">
            <annotation>
               <documentation>Gebiet einer Satzung/Verordnung nach § 172 Abs. 1.2 BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="17002">
            <annotation>
               <documentation>Gebiet einer Satzung/Verordnung nach § 172 Abs. 1.3 BauGB</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2300">
            <annotation>
               <documentation>Städtebauliches Entwicklungskonzept zur Stärkung der Innenentwicklung</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2400">
            <annotation>
               <documentation>Gebiet mit einem angespannten Wohnungsmarkt</documentation>
            </annotation>
         </enumeration>
         <enumeration value="2500">
            <annotation>
               <documentation>Gebiet mit angespanntem Wohnungsmarkt, in dem die Begründung oder Teilung von Wohnungseigentum oder Teileigentum der Genehmigung bedarf.</documentation>
            </annotation>
         </enumeration>
         <enumeration value="9999">
            <annotation>
               <documentation>Sonstiger Gebietstyp</documentation>
            </annotation>
         </enumeration>
      </restriction>
   </simpleType>
   <element name="SO_Gelaendemorphologie"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_GelaendemorphologieType">
      <annotation>
         <documentation>Das Landschaftsbild prägende Geländestruktur</documentation>
      </annotation>
   </element>
   <complexType name="SO_GelaendemorphologieType">
      <complexContent>
         <extension base="xplan:SO_GeometrieobjektType">
            <sequence>
               <element minOccurs="0"
                        name="artDerFestlegung"
                        type="xplan:SO_KlassifizGelaendemorphologieType">
                  <annotation>
                     <documentation>Klassifikation der Geländestruktur</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="detailArtDerFestlegung" type="gml:CodeType">
                  <annotation>
                     <documentation>Über eine Codeliste definierte detailliertere Klassifikation der Geländestruktur</documentation>
                     <appinfo>
                        <referenzierteCodelist>xplan:SO_DetailKlassifizGelaendemorphologie</referenzierteCodelist>
                     </appinfo>
                  </annotation>
               </element>
               <element minOccurs="0" name="name" type="string">
                  <annotation>
                     <documentation>Informelle Bezeichnung der Struktur</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Amtliche Bezeichnung / Kennziffer der Struktur</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element abstract="true"
            name="SO_Geometrieobjekt"
            substitutionGroup="xplan:SO_Objekt"
            type="xplan:SO_GeometrieobjektType">
      <annotation>
         <documentation>Basisklasse für alle Objekte mit variablem Raumbezug. Ein konkretes Objekt muss entweder punktförmigen, linienförmigen oder flächenhaften Raumbezug haben, gemischte Geometrie ist nicht zugelassen.</documentation>
      </annotation>
   </element>
   <complexType abstract="true" name="SO_GeometrieobjektType">
      <complexContent>
         <extension base="xplan:SO_ObjektType">
            <sequence>
               <element name="position" type="gml:GeometryPropertyType">
                  <annotation>
                     <documentation>Raumbezug - Entweder punktförmig, linienförmig oder flächenhaft, gemischte Geometrie ist nicht zugelassen.</documentation>
                  </annotation>
               </element>
               <element default="false"
                        minOccurs="0"
                        name="flaechenschluss"
                        type="boolean">
                  <annotation>
                     <documentation>Zeigt bei flächenhaftem Raumbezug an, ob das Objekt als Flächenschlussobjekt oder Überlagerungsobjekt gebildet werden soll. Flächenschlussobjekte dürfen sich nicht überlappen, sondern nur an den Flächenrändern berühren, wobei die jeweiligen Stützpunkte der Randkurven übereinander liegen müssen. Die Vereinigung der Flächenschlussobjekte überdeckt den Geltungsbereich des sonstigen raumbezogenen Plans vollständig.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="flussrichtung" type="boolean">
                  <annotation>
                     <documentation>Das Attribut ist nur relevant, wenn ein Geometrieobjekt einen linienhaften Raumbezug hat. &#xD;
Ist es mit dem Wert "true" belegt, wird damit ausgedrückt, dass der Linie eine Flussrichtung (z.B. die Fließrichtung eines Fließgewässers oder einer Produktenleitung)  in Digitalisierungsrichtung zugeordnet ist. Ein Attributwert "false" kennzeichnet eine Flussrichtung gegen die Digitalisierungsrichtung. Dies ist unabhängig davon, ob in der abgeleiteten Klasse die Bedeutung der Flussrichtung festgelegt ist. &#xD;
Wenn das Attribut "flussrichtung" belegt ist,  darf bei Im- und Export die Digitalisierungsreihenfolge der Stützpunkte nicht geändert werden. &#xD;
Wenn eine abgeleitete Klasse die Bedeutung der Flussrichtung nicht definiert, bleibt es der Implementierung überlassen, wie eine über "flussrichtung" definierte Flussrichtung zu interpretieren oder bei einer Plandarstellung zu visualisieren ist. Wenn in diesem Fall das Attribut "flussrichtung" nicht belegt ist, kann die Linienrichtung vom importierenden System an die eigenen technischen Bedarfe angepasst werden.&#xD;
Wenn eine abgeleitete Klasse die Bedeutung der Flussrichtung definiert, und im konkreten Objekt das Attribut "flussrichtung" nicht  belegt ist, ist die Flussrichtung die Digitalisierungsrichtung der Linie. Auch in diesem Fall darf bei Im- und Export die Digitalisierungsrichtung nicht geändert werden.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nordwinkel" type="gml:AngleType">
                  <annotation>
                     <documentation>Orientierung des Objektes bei punktförmigem Raumbezug als Winkel gegen die Nordrichtung. Zählweise im geographischen Sinn (von Nord über Ost nach Süd und West)</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Gewaesser"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_GewaesserType">
      <annotation>
         <documentation>Planartübergreifende Klasse zur Abbildung von Gewässern</documentation>
      </annotation>
   </element>
   <complexType name="SO_GewaesserType">
      <complexContent>
         <extension base="xplan:SO_GeometrieobjektType">
            <sequence>
               <element maxOccurs="unbounded"
                        minOccurs="0"
                        name="artDerFestlegung"
                        type="xplan:SO_KomplexeFestlegungGewaesserPropertyType">
                  <annotation>
                     <documentation>Klassifizierung des Gewässers</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="name" type="string">
                  <annotation>
                     <documentation>Informelle Bezeichnung dees Gewässers</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="nummer" type="string">
                  <annotation>
                     <documentation>Amtliche Bezeichnung / Kennziffer des Gewässers.</documentation>
                  </annotation>
               </element>
            </sequence>
         </extension>
      </complexContent>
   </complexType>
   <element name="SO_Grenze"
            substitutionGroup="xplan:SO_Geometrieobjekt"
            type="xplan:SO_GrenzeType">
      <annotation>
         <documentation>Grenze einer Verwaltungseinheit oder sonstige Grenze in raumbezogenen Plänen.</documentation>
      </annotation>
   </element>
