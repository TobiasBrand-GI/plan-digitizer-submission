                     <documentation>Für die Planung zuständige Institution falls von der Gemeinde abweichend, z.B. ein Planungsverband.</documentation>
                  </annotation>
               </element>
               <element minOccurs="0" name="rechtsstand" type="xplan:LP_RechtsstandType">
